# docker/env.template ｜ 部署环境变量模板（占位符，禁真实值；真实值只写部署副本 .env.local）
PROJECT_SLUG=pepe-doge-breakout-radar
COMPOSE_PROJECT_NAME=pepe-doge-breakout-radar
APP_PORT=5001
PUBLIC_APP_URL=http://localhost:5001
APP_DATA_DIR=/Users/zzymima0000/DockerData/pepe-doge-breakout-radar/db
APP_BACKUP_DIR=/Users/zzymima0000/DockerBackups/pepe-doge-breakout-radar
IMAGE_TAG=latest
# SQLite 主库（容器内路径，对应 bind mount）
SQLITE_DB_PATH=/app/data/db/pepe-doge-breakout-radar.db
# Web Push（部署环境独立密钥对，真实值只写部署副本 .env.local）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:radar@localhost
# 推送检查间隔毫秒（可选，默认 60000）
PUSH_CHECK_INTERVAL_MS=60000
